// Copy to wifi_config.h (gitignored) and fill in. The bridge joins your LAN as a station.
#pragma once

// Primary network — for flights, make this a dedicated phone hotspot at the flying spot
// (one clean AP beats a busy home mesh: no repeater duplicates, no neighbor congestion).
#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// Optional fallback network (e.g. the home LAN for bench work). Comment out if unused.
// #define WIFI_SSID2 "home-ssid"
// #define WIFI_PASS2 "home-password"

// mDNS hostname: scripts reach the bridge as whoop-bridge.local, whatever DHCP does.
#define MDNS_NAME "whoop-bridge"

// UDP port the bridge listens on; the host sends raw MSP frames here.
#define UDP_PORT 14550

// FC UART baud. Betaflight MSP ports default to 115200.
#define FC_BAUD 115200

// ---- The wiring block: every solder joint on the board, one define per net. ----
// main.cpp static_asserts that no two nets share a GPIO, so a typo here fails the BUILD
// rather than surfacing as a mystery dead sensor after the airframe is closed up.
// XIAO ESP32-S3 silkscreen -> GPIO: D0=1 D1=2 D2=3 D3=4 D4=5 D5=6 D6=43 D7=44 D8=7 D9=8 D10=9.
// (Avoid D7/GPIO44 — see the pin history in README.md.)

// Flight controller's free UART pads (UART1 on the Matrix 1S 5IN1 II).
// XIAO TX -> FC RX pad (R1), XIAO RX -> FC TX pad (T1), GND -> GND.
#define FC_TX_PIN 1   // XIAO silkscreen D0 (GPIO1) -> FC R1 (rx1)
#define FC_RX_PIN 2   // XIAO silkscreen D1 (GPIO2) -> FC T1 (tx1)

// VL53L1X ToF (CJMCU-531) I2C. Defaults (in main.cpp) are D5/D6 — override if wired elsewhere.
#define TOF_SDA_PIN 6   // XIAO silkscreen D5  -> SDA
#define TOF_SCL_PIN 43  // XIAO silkscreen D6  -> SCL

// PMW3901 optical flow (SPI). These match the defaults in include/pmw3901.h, so a config
// written before the flow sensor existed still builds — override only if you wired it
// elsewhere. D8/D9/D10 are the hardware-SPI trio; CS is any free GPIO.
#define FLOW_SCK_PIN  7   // XIAO silkscreen D8  -> CLK
#define FLOW_MISO_PIN 8   // XIAO silkscreen D9  -> MIS
#define FLOW_MOSI_PIN 9   // XIAO silkscreen D10 -> MOS
#define FLOW_CS_PIN   4   // XIAO silkscreen D3  -> CS
